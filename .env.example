# Copy this file to .env and set your values before starting the app.
# .env is git-ignored and must never be committed.

# Admin password for the RAG knowledge base and LLM config endpoints.
# Must match on both server (ADMIN_PASSWORD) and client (VITE_ADMIN_PASSWORD).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

#Prisma AIRS AI Gateway configuration (Strata Cloud Manager Managed): 
VITE_PORTKEY_BASE_URL=https://aigw.portkey.ai/v1
VITE_PORTKEY_PROVIDER=<the slug of the LLM provider you want to use, e.g. @gpt-4-1-mini>
VITE_PORTKEY_MODEL=<llm model name, e.g. gpt-4.1-mini>
VITE_PORTKEY_SCM_REPORT_URL=https://stratacloudmanager.paloaltonetworks.com/ai-security/runtime/ai-sessions/${sessionId}/cb438e85-21b3-49cd-a2a8-9c6dc609a76d/Portkey-azure-openai

#Direct LLM for Unsecured LLM access (no Prisma AIRS AI Gateway): 
VITE_DIRECT_BASE_URL=<the base URL of your Azure OpenAI instance, e.g. https://<your-resource-name>.openai.azure.com/openai/v1/chat/completions>
VITE_DIRECT_MODEL=<llm model name, e.g. gpt-4.1-mini>
