# Copy this file to .env and set your values before starting the app.
# .env is git-ignored and must never be committed.

# Admin password for the RAG knowledge base and LLM config endpoints.
# Must match on both server (ADMIN_PASSWORD) and client (VITE_ADMIN_PASSWORD).
ADMIN_PASSWORD=your_admin_password_here
VITE_ADMIN_PASSWORD=your_admin_password_here
